{
  "functions": {
    "api/index.js": {
      "includeFiles": "{branchly.html,index.html,logo.png,assets/**,videos/**,Videos/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
